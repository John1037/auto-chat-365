{
  "name": "chat365",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"],
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  // Hourly -- generous relative to what either job actually needs (stats become
  // "ready" once a day plus a 24h grace period; retention is measured in months),
  // but keeps each run's batch small and self-healing if a run is ever missed.
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
