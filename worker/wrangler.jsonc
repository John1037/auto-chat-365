{
  "name": "chat365",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
