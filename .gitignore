# Dependencies
node_modules/

# Build output
widget/dist/
worker/public/widget.js
worker/public/login.js
worker/public/app-shell.js
worker/public/widgets.js
worker/public/knowledge-base-review.js
worker/public/knowledge-base-embed.js

# Secrets -- never commit real keys. worker/.dev.vars holds local dev secrets for
# `wrangler dev`; production secrets are pushed via `wrangler secret put`.
.env
.env.local
.env.*.local
worker/.dev.vars

# Wrangler local state (regenerated by `wrangler dev`, not checked in)
.wrangler/
worker/.wrangler/

# Supabase CLI local state (regenerated by `supabase start`/`db reset`, not checked in)
supabase/.branches/
supabase/.temp/

# OS/editor cruft
.DS_Store
Thumbs.db
