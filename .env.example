# Copy to supabase/.env.local for `supabase functions serve`, and set the same values
# in production via `supabase secrets set --env-file .env.production` (never commit
# that file). Never put any of these in the widget bundle.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
